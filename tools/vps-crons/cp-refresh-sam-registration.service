[Unit]
Description=CapturePilot VPS cron - refresh_sam_registration
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/capturepilot/cron.env
WorkingDirectory=/opt/capturepilot/vps-crons
ExecStart=/usr/bin/node /opt/capturepilot/vps-crons/refresh_sam_registration.mjs
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10min
