# ============================================================
# CapturePilot — .env.example
# Copy to .env.local (gitignored) and fill in real values.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# SAM.gov (must be passed via X-Api-Key header — not URL params)
SAM_API_KEY=

# OpenAI (AI Proposal, brand extraction, capability statement drafting)
OPENAI_API_KEY=

# DeepSeek V3.2/V4 (optional — auto-used by lib/llm/deepseek.ts when set)
# 70-90% cheaper than OpenAI for bulk / long-context work. Falls back to OpenAI if empty.
DEEPSEEK_API_KEY=

# Stripe veteran discount — 20% off forever for verified SDVOSB/VOSB
# Set to `VETERAN20_FOREVER` after running scripts/setup-stripe.ts
STRIPE_VETERAN_COUPON_ID=

# Resend (transactional email)
RESEND_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# HubSpot CRM
# ============================================================
# Private App token (recommended) — create at
#   HubSpot > Settings > Integrations > Private Apps
# Requires scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                   crm.objects.deals.read, crm.objects.deals.write
# Used for: contact upserts on signup + onboarding + admin client creation,
#           deal pipeline sync.
HUBSPOT_API_KEY=
# Back-compat aliases — the code reads any of these:
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional: HubSpot pipeline + stage IDs (populated by tools/setup-hubspot-account.mjs)
HUBSPOT_SAAS_PIPELINE_ID=
HUBSPOT_SAAS_STAGE_QUICK_CHECK=
HUBSPOT_SAAS_STAGE_EMAIL_CAPTURED=
HUBSPOT_SAAS_STAGE_SIGNED_UP=
HUBSPOT_SAAS_STAGE_ONBOARDING_DONE=
HUBSPOT_SAAS_STAGE_ENGAGED=
HUBSPOT_SAAS_STAGE_TRIAL=
HUBSPOT_SAAS_STAGE_SUBSCRIBED=
HUBSPOT_SAAS_STAGE_CHURNED=

HUBSPOT_AGENCY_PIPELINE_ID=
HUBSPOT_AGENCY_STAGE_INQUIRY=
HUBSPOT_AGENCY_STAGE_DISCOVERY_BOOKED=
HUBSPOT_AGENCY_STAGE_DISCOVERY_DONE=
HUBSPOT_AGENCY_STAGE_PROPOSAL=
HUBSPOT_AGENCY_STAGE_CONTRACT=
HUBSPOT_AGENCY_STAGE_ONBOARDING=
HUBSPOT_AGENCY_STAGE_ACTIVE_CLIENT=
HUBSPOT_AGENCY_STAGE_CLOSED_LOST=

HUBSPOT_CAPTURE_PIPELINE_ID=
