{
  "name": "CapturePilot — HubSpot pipeline sync (every 15 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "trigger-15min",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://ryxgjzehoijjvczqkhwr.supabase.co/rest/v1/user_pursuits?select=id,stage,priority,hubspot_deal_id,updated_at&hubspot_deal_id=not.is.null&updated_at=gte.{{ $now.minus({minutes: 20}).toISO() }}&limit=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-recent-pursuits",
      "name": "Fetch pursuits updated in last 20 min",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Per-pursuit loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 400]
    },
    {
      "parameters": {
        "jsCode": "// Map internal pipeline stage → HubSpot stage ID env var\nconst stageMap = {\n  discovered:   $env.HUBSPOT_STAGE_DISCOVERED,\n  researching:  $env.HUBSPOT_STAGE_RESEARCHING,\n  preparing:    $env.HUBSPOT_STAGE_PREPARING,\n  submitted:    $env.HUBSPOT_STAGE_SUBMITTED,\n  awarded:      $env.HUBSPOT_STAGE_AWARDED,\n  lost:         $env.HUBSPOT_STAGE_LOST,\n  no_bid:       $env.HUBSPOT_STAGE_NO_BID,\n};\nconst item = $input.item.json;\nconst hubspotStage = stageMap[item.stage] || stageMap.discovered;\nreturn { json: { ...item, hubspot_stage_id: hubspotStage } };"
      },
      "id": "map-stage",
      "name": "Map stage → HubSpot stage ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/deals/{{ $json.hubspot_deal_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"properties\": { \"dealstage\": \"{{ $json.hubspot_stage_id }}\" } }",
        "options": {}
      },
      "id": "patch-hubspot",
      "name": "PATCH HubSpot deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Every 15 min": {
      "main": [[{ "node": "Fetch pursuits updated in last 20 min", "type": "main", "index": 0 }]]
    },
    "Fetch pursuits updated in last 20 min": {
      "main": [[{ "node": "Per-pursuit loop", "type": "main", "index": 0 }]]
    },
    "Per-pursuit loop": {
      "main": [
        [],
        [{ "node": "Map stage → HubSpot stage ID", "type": "main", "index": 0 }]
      ]
    },
    "Map stage → HubSpot stage ID": {
      "main": [[{ "node": "PATCH HubSpot deal", "type": "main", "index": 0 }]]
    },
    "PATCH HubSpot deal": {
      "main": [[{ "node": "Per-pursuit loop", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
