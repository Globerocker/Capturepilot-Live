{
  "name": "CapturePilot — Outreach drip (3-touch sequence)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "trigger-daily-9utc",
      "name": "Daily 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "url": "=https://ryxgjzehoijjvczqkhwr.supabase.co/rest/v1/marketing_leads?select=id,email,first_name,company,created_at,lead_brief_status&lead_brief_status=eq.done&created_at=lte.{{ $now.minus({days: 3}).toISO() }}&drip_status=is.null&limit=20",
        "options": {
          "headers": {
            "Authorization": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}",
            "apikey": "={{ $env.SUPABASE_SERVICE_KEY }}"
          }
        }
      },
      "id": "fetch-leads",
      "name": "Fetch leads (3d-old, not drip-tagged)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Per-lead loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"CapturePilot <hello@capturepilot.com>\",\n  \"to\": \"{{ $json.email }}\",\n  \"subject\": \"Quick follow-up on your CapturePilot report\",\n  \"html\": \"<p>Hi {{ $json.first_name || 'there' }}, just checking in after your Quick Check on <strong>{{ $json.company }}</strong>. The full report is still live — open in <a href='https://app.capturepilot.com/check'>your dashboard</a>. Need help interpreting any of the matches? Just reply.</p>\"\n}",
        "options": {
          "headers": {
            "Authorization": "=Bearer {{ $env.RESEND_API_KEY }}"
          }
        }
      },
      "id": "resend-send",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://ryxgjzehoijjvczqkhwr.supabase.co/rest/v1/marketing_leads?id=eq.{{ $('Per-lead loop').item.json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"drip_status\": \"touch_1_sent\", \"drip_last_touch_at\": \"{{ $now.toISO() }}\" }",
        "options": {
          "headers": {
            "Authorization": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}",
            "apikey": "={{ $env.SUPABASE_SERVICE_KEY }}",
            "Prefer": "return=minimal"
          }
        }
      },
      "id": "tag-sent",
      "name": "Mark drip_status=touch_1_sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Daily 09:00 UTC": {
      "main": [[{ "node": "Fetch leads (3d-old, not drip-tagged)", "type": "main", "index": 0 }]]
    },
    "Fetch leads (3d-old, not drip-tagged)": {
      "main": [[{ "node": "Per-lead loop", "type": "main", "index": 0 }]]
    },
    "Per-lead loop": {
      "main": [
        [{ "node": "Send via Resend", "type": "main", "index": 0 }],
        []
      ]
    },
    "Send via Resend": {
      "main": [[{ "node": "Mark drip_status=touch_1_sent", "type": "main", "index": 0 }]]
    },
    "Mark drip_status=touch_1_sent": {
      "main": [[{ "node": "Per-lead loop", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
