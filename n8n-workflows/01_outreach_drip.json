{
  "name": "CapturePilot — Outreach drip (touch 1, 3 days after lead brief)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * *" }
          ]
        }
      },
      "id": "trigger-daily-9utc",
      "name": "Daily 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://ryxgjzehoijjvczqkhwr.supabase.co/rest/v1/marketing_leads?select=id,email,company_name,industry,inferred_profile,created_at&lead_brief_status=eq.done&drip_status=is.null&created_at=lt.{{ $now.minus({days: 3}).toISO() }}&limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-stale-leads",
      "name": "Fetch leads needing touch 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Per-lead loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.RESEND_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"Andre @ CapturePilot <andre@capturepilot.com>\",\n  \"to\": \"{{ $json.email }}\",\n  \"subject\": \"Quick follow-up on your CapturePilot lead brief\",\n  \"html\": \"<p>Hi,</p><p>Just circling back — you ran a lead brief on CapturePilot three days ago for {{ $json.company_name }}. Were the matches useful?</p><p>Happy to dig deeper on the top picks or wire up a daily watchlist for you. Reply to this email and I'll take it from there.</p><p>— Andre, CapturePilot</p>\"\n}",
        "options": {}
      },
      "id": "resend-touch-1",
      "name": "Send touch 1 via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://ryxgjzehoijjvczqkhwr.supabase.co/rest/v1/marketing_leads?id=eq.{{ $('Per-lead loop').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"drip_status\": \"touch_1_sent\", \"drip_last_touch_at\": \"{{ $now.toISO() }}\" }",
        "options": {}
      },
      "id": "tag-sent",
      "name": "Tag drip_status=touch_1_sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Daily 09:00 UTC": {
      "main": [[{ "node": "Fetch leads needing touch 1", "type": "main", "index": 0 }]]
    },
    "Fetch leads needing touch 1": {
      "main": [[{ "node": "Per-lead loop", "type": "main", "index": 0 }]]
    },
    "Per-lead loop": {
      "main": [
        [],
        [{ "node": "Send touch 1 via Resend", "type": "main", "index": 0 }]
      ]
    },
    "Send touch 1 via Resend": {
      "main": [[{ "node": "Tag drip_status=touch_1_sent", "type": "main", "index": 0 }]]
    },
    "Tag drip_status=touch_1_sent": {
      "main": [[{ "node": "Per-lead loop", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}
